---
const year = new Date().getFullYear()

const SOCIAL = [
  { label: 'Discord', href: 'https://discord.gg/xHJrCNA8y5' },
  { label: 'GitHub', href: 'https://github.com/Devollox/void-webhooks' },
]

const PRODUCT = [
  { label: 'Download client', href: 'https://voidpresence.com/download' },
  { label: 'Profiles and cycles', href: 'https://voidpresence.com/configs' },
]

const RESOURCES = [
  { label: 'Docs', href: 'https://voidpresence.com/docs' },
  { label: 'Status', href: 'https://voidpresence.com/status' },
  { label: 'API', href: 'https://voidpresence.com/api' },
  { label: 'WebHooks', href: 'https://webhooks.voidpresence.com' },
]

const META = [
  { label: 'Changelog', href: 'https://github.com/Devollox/void-presence/releases' },
  { label: 'Repository', href: 'https://github.com/Devollox/void-webhooks' },
]
---

<style>
  .footer_container {
    background: #000;
    border-top: 1px solid #222;
    position: relative;
    padding: 32px 0 24px;
    overflow: hidden;
  }

  .footer_inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .footer_grid {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media (min-width: 768px) {
    .footer_grid { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  }

  @media (min-width: 1024px) {
    .footer_grid { grid-template-columns: minmax(0, 2.2fr) minmax(0, 3fr); }
  }

  .footer_brand_column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer_brand_header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer_logo_circle {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #0a0a0ad9;
    border: 1px solid #ffffff1f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    letter-spacing: 0.16em;
    color: #f9fafb;
    flex-shrink: 0;
  }

  .footer_brand_title {
    font-size: 20px;
    font-weight: 600;
    color: #e5e7eb;
    margin: 0 0 2px;
  }

  .footer_brand_text {
    margin: 0;
    font-size: 13px;
    color: #9ca3af;
    max-width: 320px;
  }

  .footer_social_row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer_social_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 999px;
    background: #0a0a0ad9;
    border: 1px solid #ffffff1f;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .footer_social_button:hover {
    background: #1a1a1a8e;
    border-color: #ffffff0f;
  }

  .footer_social_label {
    font-size: 12px;
    color: #e5e7eb;
    letter-spacing: 0.02em;
  }

  .footer_made_row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #6b7280;
  }

  .footer_made_dot {
    font-size: 10px;
    color: #ef4444;
  }

  .footer_links_column {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .footer_links_column {
      display: flex;
      justify-content: space-around;
    }
  }

  .footer_links_group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer_group_title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #e5e7eb;
    margin: 0 0 4px;
  }

  .footer_links_list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer_link_item {
    display: inline-block;
    padding: 2px 0;
    font-size: 13px;
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer_link_item:hover { color: #e5e7eb; }

  .footer_bottom_bar {
    border-top: 1px solid #ffffff1f;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .footer_bottom_bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer_bottom_text {
    font-size: 12px;
    color: #6b7280;
  }

  .footer_bottom_sub {
    margin-top: 2px;
    font-size: 11px;
    color: #4b5563;
  }

  .footer_bottom_meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .footer_chip {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #0a0a0ad9;
    border: 1px solid #ffffff1f;
    color: #9ca3af;
    margin-left: 10px;
  }
</style>

<footer class="footer_container">
  <div class="footer_inner">
    <div class="footer_grid">

      <!-- brand -->
      <div class="footer_brand_column">
        <div class="footer_brand_header">
          <div class="footer_logo_circle">vP</div>
          <div>
            <h3 class="footer_brand_title">Void Presence</h3>
            <p class="footer_brand_text">
              Advanced Discord Rich Presence manager with profiles, cycles, buttons and images.
            </p>
          </div>
        </div>

        <div class="footer_social_row">
          {SOCIAL.map(link => (
            <a href={link.href} target="_blank" rel="noreferrer" class="footer_social_button">
              <span class="footer_social_label">{link.label}</span>
            </a>
          ))}
        </div>

        <div class="footer_made_row">
          <span>Built with focus by</span>
          <span class="footer_made_dot">●</span>
          <span>devollox</span>
        </div>
      </div>

      <!-- links -->
      <div class="footer_links_column">
        <div class="footer_links_group">
          <h4 class="footer_group_title">Product</h4>
          <ul class="footer_links_list">
            {PRODUCT.map(link => (
              <li>
                <a href={link.href} class="footer_link_item">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="footer_links_group">
          <h4 class="footer_group_title">Resources</h4>
          <ul class="footer_links_list">
            {RESOURCES.map(link => (
              <li>
                <a href={link.href} class="footer_link_item">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="footer_links_group">
          <h4 class="footer_group_title">Meta</h4>
          <ul class="footer_links_list">
            {META.map(link => (
              <li>
                <a href={link.href} target="_blank" rel="noreferrer" class="footer_link_item">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <!-- bottom bar -->
    <div class="footer_bottom_bar">
      <div class="footer_bottom_text">
        <div>© {year} Void Presence. All rights reserved.</div>
        <div class="footer_bottom_sub">
          GitHub to Discord notification service — subscriptions, signatures and async delivery.
        </div>
      </div>
      <div class="footer_bottom_meta">
        <span class="footer_chip">NestJS · Fastify</span>
        <span class="footer_chip">GitHub Webhooks</span>
      </div>
    </div>

  </div>
</footer>
